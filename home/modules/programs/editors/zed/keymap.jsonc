[
  {
    "bindings": {
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-t": "workspace::ActivatePaneDown",
      "alt-n": "workspace::ActivatePaneUp",
      "alt-s": "workspace::ActivatePaneRight",
      "alt-0": "zed::ResetAllZoom",
      "alt-=": [
        "action::Sequence",
        [
          "zed::IncreaseBufferFontSize",
          "zed::IncreaseUiFontSize",
        ],
      ],
      "alt--": [
        "action::Sequence",
        [
          "zed::DecreaseBufferFontSize",
          "zed::DecreaseUiFontSize",
        ],
      ],
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space": null, // Disable the default action vim::WrappingRight
      "i": ["vim::PushObject", { "around": false }],
      "a": ["vim::PushObject", { "around": true }],
      "left": "vim::Left",
      "h": "vim::Left",
      "down": "vim::Down",
      "t": "vim::Down",
      "up": "vim::Up",
      "n": "vim::Up",
      "right": "vim::Right",
      "s": "vim::Right",
      "shift-g": "vim::EndOfDocument",

      "*": "vim::MoveToNext",
      "#": "vim::MoveToPrevious",
      "k": "vim::MoveToNextMatch",
      "j": ["vim::PushFindForward", { "before": true, "multiline": false }],
      "ctrl-[": "vim::SwitchToNormalMode",
      "shift-r": "vim::ToggleReplace",
      "g shift-r": "vim::PushReplaceWithRegister",
      "g shift-i": "editor::GoToImplementation",
      "g shift-a": "editor::FindAllReferences", // zed specific
      "g j": ["vim::Down", { "display_lines": true }],
      "g k": ["vim::Up", { "display_lines": true }],
      "shift-l": "vim::WindowBottom",
      ":": "vim::Repeat",
    },
  },
  {
    "context": "VimControl && VimCount",
    "bindings": {
      "0": ["vim::Number", 0],
      ":": "vim::CountCommand",
      "%": "vim::GoToPercentage",
    },
  },
  {
    "context": "vim_mode == helix_select",
    "bindings": {
      "v": "vim::NormalBefore",
      ",": "vim::HelixCollapseSelection",
      "ctrl-'": "vim::ChangeCase",
      "i": "vim::InsertBefore",
      "a": "vim::HelixAppend",
      "l": "vim::Substitute",
      "`": "vim::PushRegister",
      ":": "vim::Repeat",
    },
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-u": "editor::DeleteToBeginningOfLine",
      "ctrl-d": "vim::Outdent",
    },
  },
  {
    "context": "showing_completions",
    "bindings": {
      "ctrl-t": "vim::ScrollDown",
      "ctrl-n": "vim::ScrollUp",
      "ctrl-e": "vim::LineDown",
      "ctrl-y": "vim::LineUp",
    },
  },
  {
    "context": "(vim_mode == normal || vim_mode == helix_normal) && !menu",
    "bindings": {
      "escape": "editor::Cancel",
      "p": ["vim::Paste", { "before": true }],
      "shift-p": "vim::Paste",
      "l": "vim::Substitute",
      "`": "vim::PushRegister",
    },
  },
  {
    "context": "VimControl && vim_mode == helix_normal && !menu && !BufferSearchBar",
    "bindings": {
      "t": ["vim::Down", { "display_lines": true }],
      "down": ["vim::Down", { "display_lines": true }],
      "n": ["vim::Up", { "display_lines": true }],
      "up": ["vim::Up", { "display_lines": true }],
      "g down": "vim::Down",
      "g up": "vim::Up",
      "shift-a": "vim::HelixInsertEndOfLine",
    },
  },

  // Vim/Helix consume Escape before menu::Cancel can dismiss notifications. macOS (Ctrl-C) and Linux
  // (Ctrl-Escape) have alternatives, but Windows does not, so try menu::Cancel first on Windows and
  // let Escape fall through when no notification is shown.
  {
    "context": "Editor && mode == full && VimControl && vim_mode == normal && !menu && os == windows",
    "bindings": {
      "escape": "menu::Cancel",
    },
  },

  {
    "context": "VimControl && vim_mode == helix_normal && !menu",
    "bindings": {
      "escape": "vim::SwitchToHelixNormalMode",
      "i": "vim::HelixInsert",
      "a": "vim::HelixAppend",
      "ctrl-[": "editor::Cancel",
    },
  },
  {
    "context": "vim_mode == helix_select && !menu",
    "bindings": {
      "escape": "vim::SwitchToHelixNormalMode",
    },
  },
  {
    // default menu context without focused search bar
    "context": "(menu && !search && !editing && !Editor) || EmptyPane",
    "bindings": {
      // Window mode
      "space w h": "workspace::ActivatePaneLeft",
      "space w s": "workspace::ActivatePaneRight",
      "space w n": "workspace::ActivatePaneUp",
      "space w t": "workspace::ActivatePaneDown",
      "space w q": "pane::CloseAllItems",
      "space w r": "pane::SplitRight",
      "space w d": "pane::SplitDown",

      // Space mode
      "space space": "file_finder::Toggle",
      "space t": "workspace::ToggleLeftDock",
      "space o r": ["projects::OpenRecent", { "create_new_window": false }],
      "space o d": "workspace::Open",
      "space o s": [
        "projects::OpenRemote",
        { "from_existing_connection": false, "create_new_window": false },
      ],

      "space shift-s": "project_symbols::Toggle",

      // Other
      ";": "command_palette::Toggle",
    },
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      // Movement
      "h": "vim::WrappingLeft",
      "left": "vim::WrappingLeft",
      "s": "vim::WrappingRight",
      "right": "vim::WrappingRight",
      "t": "vim::Down",
      "n": "vim::Up",
      "j": ["vim::PushFindForward", { "before": true, "multiline": true }],
      "f": ["vim::PushFindForward", { "before": false, "multiline": true }],
      "shift-j": ["vim::PushFindBackward", { "after": true, "multiline": true }],
      "shift-f": ["vim::PushFindBackward", { "after": false, "multiline": true }],
      "shift-g": "vim::HelixGotoLine",

      // Changes
      "shift-r": "editor::Paste",
      "'": "vim::ConvertToLowerCase",
      "\"": "vim::ConvertToUpperCase",
      "shift-u": "editor::Redo",
      "ctrl-u": "vim::Undo",
      "ctrl-shift-u": "vim::Redo",
      "p": ["vim::HelixPaste", { "before": true }],
      "shift-p": "vim::HelixPaste",

      // Selection manipulation
      "l": "vim::HelixSelectRegex",
      "ctrl-s": ["editor::SplitSelectionIntoLines", { "keep_selections": true }],
      ".": "vim::HelixCollapseSelection",
      "ctrl-.": "editor::SwapSelectionEnds",
      ",": "vim::HelixKeepNewestSelection",
      "%": "editor::SelectAll",
      "*": "buffer_search::UseSelectionForFind",
      "_": "vim::HelixTrimSelections",
      "ctrl-h": "editor::SelectLargerSyntaxNode",
      "ctrl-shift-h": "editor::SelectSmallerSyntaxNode",
      "ctrl-t": "editor::MoveToEndOfLargerSyntaxNode",
      "ctrl-n": "editor::MoveToStartOfLargerSyntaxNode",
      "shift-t": "editor::SelectNextSyntaxNode",
      "shift-n": "editor::SelectPreviousSyntaxNode",
      "ctrl-j": "editor::JoinLines",

      // Search
      "k": "vim::HelixSelectNext",
      "shift-k": "vim::HelixSelectPrevious",

      // Macros — Helix swaps Vim's q/Q: Q records, q replays
      "q": "vim::ReplayLastRecording",
      "shift-q": "vim::ToggleRecord",

      // Goto mode
      "g e": "vim::EndOfDocument",
      "g h": "vim::FirstNonWhitespace",
      "g l": "go_to_line::Toggle",
      "g s": "vim::EndOfLine", // "g s" default behavior is "space s"
      "g t": "vim::WindowTop",
      "g i": "editor::GoToImplementation",
      "g a": "pane::AlternateFile",
      "g n": "pane::ActivateNextItem",
      "g space": "vim::HelixJumpToWord",
      "shift-s": "pane::GoForward",
      "shift-h": "pane::GoBack",
      "g .": "vim::HelixGotoLastModification", // go to last modification
      "g shift-o": "git::ToggleStaged", // Zed specific
      "g shift-r": "git::Restore", // Zed specific

      // Window mode
      "space w s": "workspace::ActivatePaneRight",
      "space w n": "workspace::ActivatePaneUp",
      "space w t": "workspace::ActivatePaneDown",
      "space w q": "pane::CloseAllItems",
      "space w shift-t": "workspace::SwapPaneDown",
      "space w shift-n": "workspace::SwapPaneUp",
      "space w shift-s": "workspace::SwapPaneRight",

      // Space mode
      "space b": "tab_switcher::ToggleAll",
      "space f": "editor::Format",
      "space o r": ["projects::OpenRecent", { "create_new_window": false }],
      "space o d": "workspace::Open",
      "space o s": [
        "projects::OpenRemote",
        { "from_existing_connection": false, "create_new_window": false },
      ],
      "space space": "file_finder::Toggle",
      "space t": "workspace::ToggleLeftDock",

      // View mode
      "z c": "editor::ScrollCursorCenter",

      // Other
      ";": "command_palette::Toggle",
      "m": "vim::PushHelixMatch",
    },
  },
  {
    "context": "Editor && (vim_mode == helix_normal || vim_mode == helix_select) && showing_code_actions",
    "bindings": {
      "tab": "editor::ContextMenuNext",
      "shift-tab": "editor::ContextMenuPrevious",
    },
  },
  {
    "context": "vim_mode == insert && !(showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-p": "editor::ShowWordCompletions",
    },
  },
  {
    "context": "(vim_mode == insert || vim_mode == normal) && showing_signature_help && !showing_completions",
    "bindings": {
      "ctrl-p": "editor::SignatureHelpPrevious",
      "ctrl-n": "editor::SignatureHelpNext",
    },
  },
  {
    "context": "Editor && vim_mode == waiting && (vim_operator == ys || vim_operator == cs)",
    "bindings": {
      "escape": "vim::SwitchToNormalMode",
    },
  },
  {
    "context": "vim_mode == operator",
    "bindings": {
      "ctrl-[": "vim::ClearOperators",
      "escape": "vim::ClearOperators",
    },
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs || vim_operator == helix_next || vim_operator == helix_previous",
    "bindings": {
      "w": "vim::Word",
      "shift-w": ["vim::Word", { "ignore_punctuation": true }],
      "t": "vim::Tag",
      "s": "vim::Sentence",
      "'": "vim::Quotes",
      "`": "vim::BackQuotes",
      "q": "vim::MiniQuotes",
      "|": "vim::VerticalBars",
      "(": ["vim::Parentheses", { "opening": true }],
      ")": "vim::Parentheses",
      "b": "vim::Parentheses",
      "{": ["vim::CurlyBrackets", { "opening": true }],
      "}": "vim::CurlyBrackets",
      "shift-b": "vim::CurlyBrackets",
      "a": "vim::Argument",
      "i": "vim::IndentObj",
      "f": "vim::Method",
      "e": "vim::EntireFile",
    },
  },
  {
    // Helix textobject keys that differ from vim's: `mim`/`mam` select the
    // closest surrounding pair, and `t`/`c`/`x` follow Helix's meanings
    // (type, comment, xml element) instead of vim's (tag, class, unbound).
    "context": "(vim_operator == a || vim_operator == i || vim_operator == helix_next || vim_operator == helix_previous) && helix_mode",
    "bindings": {
      "m": "vim::AnyPair",
      "t": "vim::Class",
      "c": "vim::Comment",
    },
  },
  {
    "context": "vim_operator == helix_m",
    "bindings": {
      "m": ["vim::Matching", { "match_quotes": true }],
      "s": "vim::PushHelixSurroundAdd",
    },
  },
  {
    "context": "vim_operator == helix_next",
    "bindings": {
      "*": "vim::NextComment",
      "/": "vim::NextComment",
      "-": "vim::NextLesserIndent",
      "+": "vim::NextGreaterIndent",
      "b": "pane::ActivateNextItem",
      "shift-b": "pane::ActivateLastItem",
      "x": "editor::SelectSmallerSyntaxNode",
      "c": "editor::GoToHunk",
      "space": "vim::InsertEmptyLineBelow",
    },
  },
  {
    "context": "vim_operator == helix_previous",
    "bindings": {
      "*": "vim::PreviousComment",
      "/": "vim::PreviousComment",
      "-": "vim::PreviousLesserIndent",
      "+": "vim::PreviousGreaterIndent",
      "b": "pane::ActivatePreviousItem",
      "shift-b": ["pane::ActivateItem", 0],
      "x": "editor::SelectLargerSyntaxNode",
      "c": "editor::GoToPreviousHunk",
      "space": "vim::InsertEmptyLineAbove",
    },
  },
  {
    "context": "vim_operator == c",
    "bindings": {
      "s": ["vim::PushChangeSurrounds", {}],
    },
  },
  {
    "context": "vim_operator == d",
    "bindings": {
      "s": "vim::PushDeleteSurrounds",
      "v": "vim::PushForcedMotion", // "d v"
    },
  },
  {
    "context": "vim_operator == g?",
    "bindings": {
      "?": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == gq",
    "bindings": {
      "q": "vim::CurrentLine",
      "w": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == y",
    "bindings": {
      "v": "vim::PushForcedMotion",
      "s": ["vim::PushAddSurrounds", {}],
    },
  },
  {
    "context": "vim_operator == ys",
    "bindings": {
      "s": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == >",
    "bindings": {
      ">": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_operator == gR",
    "bindings": {
      "shift-r": "vim::CurrentLine",
    },
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-e": ["vim::Literal", ["ctrl-e", "\u0005"]],
      "ctrl-n": ["vim::Literal", ["ctrl-n", "\u000E"]],
      "ctrl-p": ["vim::Literal", ["ctrl-p", "\u0010"]],
      "ctrl-t": ["vim::Literal", ["ctrl-t", "\u0014"]],
      "ctrl-y": ["vim::Literal", ["ctrl-y", "\u0019"]],
    },
  },
  {
    "context": "BufferSearchBar && !in_replace",
    "bindings": {
      "enter": "vim::SearchSubmit",
      "escape": "buffer_search::Dismiss",
    },
  },
  {
    "context": "ProjectSearchBar > Editor",
    "bindings": {
      "escape": "pane::CloseActiveItem",
    },
  },
  {
    "context": "!Editor && !Terminal",
    "bindings": {
      ";": "command_palette::Toggle",
      "space w t": "workspace::ActivatePaneDown",
      "space w n": "workspace::ActivatePaneUp",
      "space w s": "workspace::ActivatePaneRight",
      "space w q": "pane::CloseActiveItem",
    },
  },
  {
    // netrw compatibility
    "context": "ProjectPanel && not_editing",
    "bindings": {
      ";": "command_palette::Toggle",
      "enter": "project_panel::OpenPermanent",
      "escape": "vim::ToggleProjectPanelFocus",
      "t": "vim::MenuSelectNext",
      "n": "vim::MenuSelectPrevious",
      "s": "project_panel::ExpandSelectedEntry",
      "l": "workspace::OpenWithSystem",
      "g e": "menu::SelectLast",
      "ctrl-u": "project_panel::ScrollUp",
      "ctrl-d": "project_panel::ScrollDown",
    },
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "h": "outline_panel::CollapseSelectedEntry",
      "t": "menu::SelectNext",
      "n": "menu::SelectPrevious",
      "s": "outline_panel::ExpandSelectedEntry",
      "g e": "menu::SelectLast",
      "-": "outline_panel::SelectParent",
      "enter": "editor::ToggleFocus",
      "/": "menu::Cancel",
      "ctrl-t": "outline_panel::ScrollUp",
      "ctrl-n": "outline_panel::ScrollDown",
      "z t": "outline_panel::ScrollCursorTop",
      "z z": "outline_panel::ScrollCursorCenter",
      "z b": "outline_panel::ScrollCursorBottom",
    },
  },
  {
    "context": "OutlinePanel && editing",
    "bindings": {
      "enter": "menu::Cancel",
    },
  },
  {
    "context": "GitGraphSearchBar > Editor",
    "bindings": {
      "tab": "git_graph::FocusNextTabStop",
      "shift-tab": "git_graph::FocusPreviousTabStop",
    },
  },
  {
    "context": "GitGraph && !GitGraphSearchBar",
    "bindings": {
      "t": "vim::MenuSelectNext",
      "n": "vim::MenuSelectPrevious",
      "ctrl-d": "git_graph::ScrollDown",
      "ctrl-u": "git_graph::ScrollUp",
      "g e": "menu::SelectLast",
    },
  },
  {
    "context": "GitPanel && (ChangesList || HistoryList) && !GitBranchSelector && !GitRepositorySelector",
    "use_key_equivalents": true,
    "bindings": {
      "t": "menu::SelectNext",
      "n": "menu::SelectPrevious",
    },
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector && !GitRepositorySelector",
    "use_key_equivalents": true,
    "bindings": {
      "h": "git_panel::CollapseSelectedEntry",
      "s": "git_panel::ExpandSelectedEntry",
      "g e": "menu::SelectLast",
      "x": "git::ToggleStaged",
    },
  },
  {
    "context": "Editor && mode == auto_height && VimControl",
    "bindings": {
      // TODO: Implement search
      "/": null,
      "?": null,
      "#": null,
      "*": null,
      "n": null,
      "shift-n": null,
    },
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-h": "editor::Backspace",
      "ctrl-u": "editor::DeleteToBeginningOfLine",
      "ctrl-w": "editor::DeleteToPreviousWordStart",
      "ctrl-n": "menu::SelectPrevious",
      "ctrl-t": "menu::SelectNext",
    },
  },
  {
    "context": "GitCommit > Editor && VimControl && vim_mode == normal",
    "bindings": {
      "ctrl-c": "menu::Cancel",
      "escape": "menu::Cancel",
    },
  },
  {
    "context": "CommitEditor > Editor && VimControl && !menu",
    "bindings": {
      "tab": "git_panel::FocusChanges",
      "shift-tab": "git_panel::FocusChanges",
    },
  },
  {
    "context": "Editor && edit_prediction && edit_prediction_mode == eager && !showing_completions",
    "bindings": {
      // This is identical to the binding in the base keymap, but the vim bindings above to
      "tab": "editor::AcceptEditPrediction",
    },
  },
  {
    "context": "MessageEditor > Editor && VimControl",
    "bindings": {
      "enter": "agent::Chat",
    },
  },
  {
    "context": "SettingsWindow > NavigationMenu && !search",
    "bindings": {
      "s": "settings_editor::ExpandNavEntry",
      "h": "settings_editor::CollapseNavEntry",
      "n": "settings_editor::FocusPreviousNavEntry",
      "t": "settings_editor::FocusNextNavEntry",
      "g g": "settings_editor::FocusFirstNavEntry",
      "g e": "settings_editor::FocusLastNavEntry",
    },
  },
  {
    "context": "MarkdownPreview",
    "bindings": {
      "ctrl-u": "markdown::ScrollPageUp",
      "ctrl-d": "markdown::ScrollPageDown",
      "ctrl-y": "markdown::ScrollUp",
      "ctrl-e": "markdown::ScrollDown",
      "g g": "markdown::ScrollToTop",
      "g e": "markdown::ScrollToBottom",
      "/": "buffer_search::Deploy",
    },
  },
  {
    "context": "FileHistoryView",
    "bindings": {
      "t": "menu::SelectNext",
      "n": "menu::SelectPrevious",
      "g g": "menu::SelectFirst",
      "g e": "menu::SelectLast",
    },
  },
  {
    "context": "NotebookEditor > Editor && VimControl && vim_mode == normal",
    "bindings": {
      "t": "notebook::NotebookMoveDown",
      "n": "notebook::NotebookMoveUp",
      "escape": "notebook::EnterCommandMode",
    },
  },
  {
    "context": "NotebookEditor && notebook_mode == command",
    "bindings": {
      "t": "menu::SelectNext",
      "n": "menu::SelectPrevious",
      "g g": "menu::SelectFirst",
      "g e": "menu::SelectLast",
      "i": "notebook::EnterEditMode",
      "a": "notebook::EnterEditMode",
      "enter": "notebook::EnterEditMode",
    },
  },
  {
    "context": "ThreadsSidebar && !Editor",
    "bindings": {
      "t": "menu::SelectNext",
      "n": "menu::SelectPrevious",
      "h": "menu::SelectParent",
      "s": "menu::SelectChild",
      "g g": "menu::SelectFirst",
      "g e": "menu::SelectLast",
      "/": "agents_sidebar::FocusSidebarFilter",
      "o": "agents_sidebar::NewThreadInGroup",
      "z c": "menu::SelectParent",
    },
  },
  {
    "context": "ThreadsSidebar > Editor && VimControl && vim_mode == normal",
    "bindings": {
      "t": "editor::MoveDown",
      "n": "editor::MoveUp",
      "/": "vim::SwitchToInsertMode",
      "escape": "menu::Cancel",
      "enter": "editor::Newline",
    },
  },
  {
    "context": "SkillCreator",
    "bindings": {
      "tab": "skill_creator::FocusNextField",
      "shift-tab": "skill_creator::FocusPreviousField",
    },
  },
  {
    "context": "SkillCreator > Editor",
    "bindings": {
      "tab": "skill_creator::FocusNextField",
      "shift-tab": "skill_creator::FocusPreviousField",
    },
  },
  {
    // Last on purpose: zed only waits for a longer sequence when it ranks above the exact match,
    // so this keeps ctrl-w immediate despite the default "ctrl-w <key>" window bindings
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      "ctrl-w": "vim::NextSubwordStart",
      "ctrl-e": "vim::NextSubwordEnd",
      "ctrl-b": "vim::PreviousSubwordStart",
    },
  },
]
